<Window x:Class="CyberSecurityChatBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kwena Mokoena's Cybersecurity Assistant" Height="620" Width="950"
        Background="#121212" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="8" Padding="10" Margin="0,0,0,10" BorderBrush="#00FF66" BorderThickness="1">
                <TextBlock x:Name="TxtAsciiHeader" FontFamily="Consolas" FontSize="11" Foreground="#00FF66" HorizontalAlignment="Center" TextAlignment="Center"/>
            </Border>

            <ScrollViewer Grid.Row="1" x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                <ItemsControl x:Name="ChatContainer">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="5" Padding="10" CornerRadius="8" MaxWidth="320"
                                    HorizontalAlignment="{Binding Alignment}" Background="{Binding BackgroundColor}">
                                <TextBlock Text="{Binding MessageText}" TextWrapping="Wrap" Foreground="{Binding TextColor}" FontSize="13" FontFamily="Segoe UI"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtInput" Grid.Column="0" Height="40" Background="#1E1E1E" Foreground="White"
                         BorderBrush="#444" BorderThickness="1" SelectionBrush="#00FF66" Padding="10,5" FontSize="13"
                         VerticalContentAlignment="Center" KeyDown="TxtInput_KeyDown"/>

                <Button x:Name="BtnSend" Grid.Column="1" Width="85" Margin="10,0,0,0" Content="SEND"
                        Background="#00FF66" Foreground="#121212" FontWeight="Bold" Click="BtnSend_Click"/>
            </Grid>
        </Grid>

        <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="8" Padding="15" BorderBrush="#444" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1.2*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="🛡️ CYBERSECURITY ACTIVE DASHBOARD" Foreground="#00FF66" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Your Registered Tasks [MySQL Persistent Storage]:" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <DataGrid x:Name="TasksDataGrid" Grid.Row="1" AutoGenerateColumns="True" Background="#121212" RowBackground="#1E1E1E" AlternatingRowBackground="#252525" Foreground="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#333" IsReadOnly="True" BorderBrush="#444"/>
                </Grid>

                <Border Grid.Row="2" Background="#121212" CornerRadius="6" Padding="12" BorderBrush="#333" BorderThickness="1">
                    <Grid>
                        <TextBlock x:Name="TxtQuizPlaceholder" Text="Type 'play quiz' to start the cybersecurity training engine game mini-module!" Foreground="#888" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>

                        <StackPanel x:Name="QuizControlPanel" Visibility="Collapsed">
                            <TextBlock Text="🔒 ACTIVE SECURITY MINI-GAME QUIZ" Foreground="#00FF66" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock x:Name="QuizQuestionText" Text="Question prompt placeholder?" Foreground="White" FontSize="13" TextWrapping="Wrap" Height="55" Margin="0,0,0,10"/>

                            <UniformGrid Columns="2" Rows="2">
                                <Button x:Name="OptA_Btn" Content="Option A" Margin="4" Padding="5" Click="QuizAnswer_Click" Background="#1E1E1E" Foreground="White" BorderBrush="#444"/>
                                <Button x:Name="OptB_Btn" Content="Option B" Margin="4" Padding="5" Click="QuizAnswer_Click" Background="#1E1E1E" Foreground="White" BorderBrush="#444"/>
                                <Button x:Name="OptC_Btn" Content="Option C" Margin="4" Padding="5" Click="QuizAnswer_Click" Background="#1E1E1E" Foreground="White" BorderBrush="#444"/>
                                <Button x:Name="OptD_Btn" Content="Option D" Margin="4" Padding="5" Click="QuizAnswer_Click" Background="#1E1E1E" Foreground="White" BorderBrush="#444"/>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>